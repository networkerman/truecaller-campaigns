PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/truecaller
# mock | truecaller
TC_PROVIDER=mock
# Truecaller Business Chat API v2 gRPC host:port. The .proto files go in server/proto/ (or TC_PROTO_DIR).
TC_API_BASE_URL=
TC_API_KEY=
TC_SENDER_ID=
# Shared secret Truecaller sends with delivery webhooks
TC_WEBHOOK_SECRET=
# Setup API keys, comma separated. Make named customer keys on the API keys page.
API_KEYS=dev-key
# Dashboard signup is limited to these email domains
ALLOWED_EMAIL_DOMAINS=onextel.com
# Where confirmation links point. Defaults to https://$DOMAIN, or the Vite dev server locally.
PUBLIC_URL=
# smtp(s)://user:pass@host:port. Empty: confirmation links go to the server log.
SMTP_URL=
MAIL_FROM=Truecaller Campaigns <no-reply@onextel.com>
