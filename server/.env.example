PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/truecaller
# mock | truecaller
TC_PROVIDER=mock
TC_API_BASE_URL=
TC_API_KEY=
TC_SENDER_ID=
# Shared secret Truecaller sends with delivery webhooks
TC_WEBHOOK_SECRET=
# Setup keys allowed to call /v1 and sign in to the dashboard. More keys can be made on the API keys page.
API_KEYS=dev-key
# Campaign messages sent per second
SEND_RATE_PER_SECOND=20
