PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/truecaller
# mock | truecaller
TC_PROVIDER=mock
TC_API_BASE_URL=
TC_API_KEY=
TC_SENDER_ID=
# Shared secret Truecaller sends with delivery webhooks
TC_WEBHOOK_SECRET=
# Setup API keys, comma separated. Make named customer keys on the API keys page.
API_KEYS=dev-key
# OneXtel super admins, comma separated. Each gets an account and an emailed invitation at startup.
SUPER_ADMIN_EMAILS=
# The sign-in link in invitation emails. Defaults to https://$DOMAIN, or the Vite dev server locally.
PUBLIC_URL=
# Invitation email: Tarang (TARANG_API_KEY) first, else SMTP. Neither: invitations go to the server log.
TARANG_API_KEY=
# smtp(s)://user:pass@host:port.
SMTP_URL=
MAIL_FROM=Truecaller Campaigns <no-reply@onextel.com>
