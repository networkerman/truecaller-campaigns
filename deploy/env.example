# /etc/truecaller-campaigns.env on the box (root, 0600). deploy/setup-env.sh creates it.
DOMAIN=truecaller.udchowdhury.me
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@db:5432/truecaller
# Setup key for the API. Make named customer keys on the API keys page.
API_KEYS=change-me
# OneXtel super admins, comma separated. Each gets an account and an emailed invitation at startup.
SUPER_ADMIN_EMAILS=udayan.chowdhury@onextel.com
# Invitation emails through Tarang (template invite). Takes priority over SMTP_URL.
TARANG_API_KEY=
TARANG_API_URL=https://tarang.udchowdhury.me
# Or SMTP. With neither, invitations (temporary passwords included) are written to the API log.
SMTP_URL=
MAIL_FROM=Truecaller Campaigns <no-reply@onextel.com>
# mock | truecaller
TC_PROVIDER=mock
# Truecaller Business Chat API v2 (gRPC). Host:port from the partner portal, TLS.
TC_API_BASE_URL=
TC_API_KEY=
TC_SENDER_ID=
# Message lifetime on Truecaller's side, in seconds.
TC_TTL_SECONDS=86400
TC_WEBHOOK_SECRET=
