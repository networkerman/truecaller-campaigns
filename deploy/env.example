# /etc/truecaller-campaigns.env on the box (root, 0600). deploy/setup-env.sh creates it.
DOMAIN=truecaller.udchowdhury.me
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@db:5432/truecaller
# Setup key for the API. Make named customer keys on the API keys page.
API_KEYS=change-me
# Dashboard signup is limited to these email domains.
ALLOWED_EMAIL_DOMAINS=onextel.com
# Confirmation emails through Tarang (template verify-email). Takes priority over SMTP_URL.
TARANG_API_KEY=
TARANG_API_URL=https://tarang.udchowdhury.me
# Confirmation emails. Leave SMTP_URL empty to write the links to the API log instead.
SMTP_URL=
MAIL_FROM=Truecaller Campaigns <no-reply@onextel.com>
# mock | truecaller
TC_PROVIDER=mock
TC_API_BASE_URL=
TC_API_KEY=
TC_SENDER_ID=
TC_WEBHOOK_SECRET=
